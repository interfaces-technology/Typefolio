{
  "name": "typefolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/app",
    "apps/web",
    "apps/marketing",
    "packages/core"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w @typefolio/api",
    "dev:app": "npm run dev -w @typefolio/app",
    "dev:web": "npm run dev -w @typefolio/web",
    "dev:marketing": "npm run dev -w @typefolio/marketing",
    "dev:native": "bash scripts/dev-all.sh",
    "build": "turbo run build",
    "start": "npm run start -w @typefolio/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "dotenv -e .env.local -- npm run db:push -w @typefolio/core",
    "check:env": "dotenv -e .env.local -- tsx scripts/check-env.ts",
    "smoke": "bash scripts/smoke-test.sh",
    "test": "npm run test -w @typefolio/core"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.2"
}
